# Telegram
# Создай бота через @BotFather и вставь сюда токен.
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# Если хочешь ограничить управление ботом только своими Telegram user id,
# впиши их через запятую. Например: 123456789,987654321
# Если оставить пустым, любой человек, написавший боту, сможет управлять списком.
TELEGRAM_ADMIN_USER_IDS=

# Helius
# API key проекта из https://dashboard.helius.dev/
HELIUS_API_KEY=PASTE_HELIUS_API_KEY_HERE

# Project ID нужен только для команды /limit.
# Его можно найти в Helius dashboard в настройках проекта.
HELIUS_PROJECT_ID=PASTE_HELIUS_PROJECT_ID_HERE

# Если webhook уже создан в Helius dashboard, можно вставить его id.
# Если оставить пустым, бот попробует создать webhook сам при первом sync.
HELIUS_WEBHOOK_ID=

# Публичный HTTPS-адрес твоего локального сервера без завершающего слеша.
# Для запуска на ПК удобно использовать ngrok/cloudflared:
#   ngrok http 8080
# и вставить сюда URL вида https://abc123.ngrok-free.app
PUBLIC_WEBHOOK_URL=PASTE_PUBLIC_HTTPS_URL_HERE

# Секретная строка для проверки, что запрос пришел от Helius.
# Можно вписать любую длинную случайную строку.
HELIUS_AUTH_HEADER=PASTE_RANDOM_SECRET_HERE

# Если true, бот будет сам создавать/обновлять Helius webhook при изменении кошельков.
# Важно: операции create/update webhook у Helius стоят credits.
HELIUS_AUTO_SYNC=true

# Авто-предупреждение в Telegram, если Helius credits осталось меньше N%.
HELIUS_USAGE_WARN_PERCENT=10

# Как часто проверять Helius usage. 360 минут = раз в 6 часов.
# Поставь 0, если авто-проверка лимита не нужна.
HELIUS_USAGE_CHECK_INTERVAL_MINUTES=360

# Server
HOST=127.0.0.1
PORT=8080

# Bot settings
# Глобальный минимальный расход SOL для уведомлений.
# Для отдельного кошелька можно поставить свой минимум через кнопки в Telegram.
DEFAULT_MIN_SOL=0.1

# SQLite-файл. Можно не менять.
DATABASE_PATH=data/pumpscanbot.sqlite3
